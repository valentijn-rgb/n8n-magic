    {
      "parameters": {
        "description": "GET - Messages Node - Complete Documentation\nGeneral Description\nCall this tool to retrieve messages, events, and surveys published on the timeline of a channel. This node queries your messaging API and returns a list of messages based on your specified parameters.\nTool Rules\n\nDefault Channel: If no channel is defined, the API uses the default value \"all\", which retrieves messages from all channels in your workspace.\nDefault Date Range: If no from and to dates are specified, take the last 3 months as best practice.\nTimestamp Format: All date parameters (from and to) must be provided in UNIX timestamp format (seconds since January 1, 1970).\nDefault Message Count: If no count is specified, the API returns 10 messages by default. Adjust the count parameter to retrieve more or fewer results.\nMessage ID for Follow-up Calls: The id field returned in the response can be used as the msg_id parameter in subsequent API calls to retrieve detailed information about individual messages.\nPerformance Note: Requesting large message counts (over 500) or wide date ranges may result in slower response times or timeouts. For best results, keep the count under 500 and limit date ranges to no more than 12 months.",
        "workflowId": {
          "__rl": true,
          "value": "jnuvuRubEf1NtTXX",
          "mode": "list",
          "cachedResultUrl": "/workflow/jnuvuRubEf1NtTXX",
          "cachedResultName": "GET - Messages"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "from": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('from', `Type: Integer (UNIX timestamp in seconds)\nRequired: No\nDefault Behavior: If not specified, defaults to 3 months before the to date\nDescription: The start date for retrieving messages, specified as a UNIX timestamp in seconds. This defines the earliest message to include in the results. If you want messages from the last 3 months, leave this empty and set to to the current time.`, 'number') }}",
            "to": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('to', `Type: Integer (UNIX timestamp in seconds)\nRequired: No\nDefault Behavior: If not specified, defaults to the current time\nDescription: The end date for retrieving messages, specified as a UNIX timestamp in seconds. This defines the latest message to include in the results. Typically set to \"now\" or the current timestamp.`, 'number') }}",
            "channel": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('channel', `Type: String\nRequired: No\nDefault Value: \"all\"\nDescription: The specific channel to retrieve messages from. Use the channel ID to filter messages to a single channel, or use \"all\" to retrieve messages from all channels in the workspace.`, 'number') }}",
            "count": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('count', `Type: Integer\nRequired: No\nDefault Value: 10\nDescription: The maximum number of messages to retrieve. This limits the result set size. Use higher values to get more messages, but be aware that larger counts may take longer to process and return more data.`, 'number') }}"
